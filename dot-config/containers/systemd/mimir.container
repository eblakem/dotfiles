[Unit]
Description=Mimir (local, via Netbird)
After=network-online.target

[Container]
Image=localhost/odin-mimir:local
Network=host
Environment=HOST=127.0.0.1
Environment=PORT=5175
EnvironmentFile=%h/.config/containers/systemd/mimir.env

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
